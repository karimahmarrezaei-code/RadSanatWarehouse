    def _reserve_qty_map(self):
        """جمع تعداد رزروشده در پیش‌فاکتورهای تبدیل‌نشده (DRAFT/FINALIZED)"""
        try:
            with self.db.connect() as conn:
                conn.row_factory = None
                rows = conn.execute(
                    "SELECT pii.pallet_id, SUM(pii.quantity) "
                    "FROM proforma_invoice_items pii "
                    "JOIN proforma_invoices pi ON pi.id = pii.proforma_id "
                    "WHERE pi.status IN ('DRAFT','FINALIZED') "
                    "GROUP BY pii.pallet_id"
                ).fetchall()
                return {r[0]: int(r[1] or 0) for r in rows}
        except Exception:
            return {}

    def _reference_remaining_qty_map(self, exclude_reference_id=None):
        """[RESERVE-REF] ماندهٔ متعهدشدهٔ مرجع‌های باز به تفکیک پالت"""
        res = {}
        try:
            with self.db.connect() as conn:
                conn.row_factory = None
                rows = conn.execute(
                    "SELECT oli.pallet_id, "
                    "       SUM(oli.qty) - COALESCE((SELECT SUM(wii.qty) "
                    "           FROM warehouse_issue_items wii "
                    "           JOIN warehouse_issues wi ON wi.id = wii.issue_id "
                    "           WHERE wi.outbound_load_id = oli.outbound_load_id "
                    "             AND wii.pallet_id = oli.pallet_id "
                    "             AND wi.issue_status != 'CANCELLED'), 0) "
                    "FROM outbound_load_items oli "
                    "JOIN outbound_loads ol ON ol.id = oli.outbound_load_id "
                    "WHERE ol.is_active = 1 AND COALESCE(ol.remaining_qty,0) > 0 AND ol.id != ? "
                    "GROUP BY oli.outbound_load_id, oli.pallet_id",
                    (exclude_reference_id or 0,)
                ).fetchall()
                for pid, rem in rows:
                    rem = int(rem or 0)
                    if rem > 0:
                        res[pid] = res.get(pid, 0) + rem
        except Exception:
            pass
        return res

    def _committed_qty_map(self, exclude_reference_id=None):
        """[RESERVE] کل تعهدات = پیش‌فاکتورهای باز + ماندهٔ مرجع‌های باز"""
        res = dict(self._reserve_qty_map())
        for pid, q in self._reference_remaining_qty_map(exclude_reference_id).items():
            res[pid] = res.get(pid, 0) + q
        return res

    def _available_for_warehouse(self, pallet_id, warehouse_id, exclude_reference_id=None):
        return int(self._stock_for_warehouse(pallet_id, warehouse_id)) - int(self._committed_qty_map(exclude_reference_id).get(pallet_id, 0))

    def save_issue(self) -> None:
        self._ac_save_all()

        if not self.can_manage:
            QMessageBox.warning(self, 'عدم دسترسی', 'شما اجازه ثبت حواله را ندارید.')
            return

        if hasattr(self, 'warehouse_combo') and not self.warehouse_combo.currentData():
            QMessageBox.warning(self, 'خطا', 'ابتدا انبار مبدأ را انتخاب کنید.')
            return

        # [RESERVE] کنترل رزرو: درخواست حواله نباید از موجودی آزاد عبور کند
        try:
            _wid = self.warehouse_combo.currentData() if hasattr(self, 'warehouse_combo') else None
            _reserved = self._committed_qty_map(self.reference_selector_combo.currentData() if hasattr(self, 'reference_selector_combo') else None)
            _req = {}
            for _ln in self._collect_lines():
                _pid = _ln.get('pallet_id')
                if _pid:
                    _req[_pid] = _req.get(_pid, 0) + int(_ln.get('quantity', 0) or 0)
            _short = []
            for _pid, _q in _req.items():
                _physical = self._stock_for_warehouse(_pid, _wid)
                _res = int(_reserved.get(_pid, 0))
                _avail = _physical - _res
                if _q > _avail:
                    _code = next((p['code'] for p in self.pallets if p['id'] == _pid), _pid)
                    _short.append('پالت {}: موجودی {:,} | رزروشده {:,} | آزاد {:,} | درخواست {:,}'.format(
                        _code, _physical, _res, _avail, _q))
            if _short:
                QMessageBox.warning(self, 'موجودی آزاد کافی نیست',
                    'جمع این حواله و پیش‌فاکتورهای باز بیش از موجودی است:\n' + '\n'.join(_short))
                return
        except Exception:
            pass
        try:
            from app.repositories.fiscal_period_repository import FiscalPeriodRepository
            locked = FiscalPeriodRepository(self.db).locked_period(self._current_iso_date())
            if locked:
                QMessageBox.warning(
                    self,
                    'دورهٔ مالی بسته',
                    f'تاریخ داخل دورهٔ بستهٔ «{locked["name"]}» است. ابتدا بازگشایی کنید.'
                )
                return
        except Exception:
            pass

        try:
            saved = self.repository.create_outbound_issue(
                self._collect_payload(),
                user_id=self.user_data.get('id')
            )
        except Exception as exc:
            QMessageBox.critical(self, 'خطا', 'ثبت حواله با خطا مواجه شد:\n{}'.format(exc))
            return

        QMessageBox.information(
            self,
            'حواله ثبت شد',
            "حواله با موفقیت ثبت و تایید شد.\nشماره مرجع: {}\nشماره حواله: {}".format(
                saved.get('reference_no'),
                saved.get('issue_no')
            )
        )

        try:
            from app.core.doc_upload_helper import open_upload_after_save
            open_upload_after_save(self, 'ISSUE', saved, self.db, self.user_data)
        except Exception as _img_exc:
            print('[doc-images] upload error:', _img_exc)

        self._load_lookups()
        self._load_pallet_prices()
        self.refresh_issues_final()
        self.clear_form()
        self.data_changed.emit()

        if saved.get('print_html'):
            self._open_html_in_browser(saved['print_html'])

