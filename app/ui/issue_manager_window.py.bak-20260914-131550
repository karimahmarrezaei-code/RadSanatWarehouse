            self.reference_selector_combo.blockSignals(False)
            return
        wh_map = {}
        try:
            with self.db.connect() as conn:
                for r in conn.execute("""SELECT wi.outbound_load_id, wii.warehouse_id
                    FROM warehouse_issues wi
                    JOIN warehouse_issue_items wii ON wii.issue_id=wi.id
                    WHERE COALESCE(wi.issue_status,'CONFIRMED')<>'CANCELLED'"""):
                    wh_map.setdefault(r[0], set()).add(r[1])
        except Exception:
            pass
        try:
            with self.db.connect() as conn:
                conn.row_factory = None
                rows = conn.execute("""
                    SELECT ol.id, ol.reference_no, ol.customer_id,
                           (SELECT COALESCE(SUM(qty), 0) FROM outbound_load_items WHERE outbound_load_id = ol.id),
                           COALESCE((SELECT COALESCE(SUM(wii.qty), 0) FROM warehouse_issue_items wii JOIN warehouse_issues wi ON wi.id = wii.issue_id WHERE wi.outbound_load_id = ol.id AND wi.issue_status != 'CANCELLED'), 0),
                           (SELECT COUNT(*) FROM warehouse_issues wi
                             WHERE wi.outbound_load_id = ol.id
                               AND wi.issue_status != 'CANCELLED'),
                 ol.warehouse_id
                 FROM outbound_loads ol
                    WHERE ol.is_active = 1
                    ORDER BY ol.id DESC
                """).fetchall()
            for row in rows:
                ref_id, ref_no, cust_id = row[0], row[1] or 'نامشخص', row[2]
                total_load = int(row[3] or 0)
                delivered_sum = int(row[4] or 0)
                issue_cnt = int(row[5] or 0)
                remaining = max(total_load - delivered_sum, 0)
                if issue_cnt > 0 and remaining <= 0:
                    continue
                ol_wh = row[6]
                rws = wh_map.get(ref_id) or set()
                if ol_wh:
                    if int(ol_wh) != int(wid):
                        continue
                else:
                    inferred = self._infer_reference_warehouse(ref_id)
                    if inferred:
                        if int(inferred) != int(wid):
                            continue
                    elif rws and (None not in rws) and (wid not in rws):
                        continue
                cust_name = cust_map.get(cust_id, '-') if cust_id else '-'
                label = "{} | مشتری: {} | مانده: {:,}".format(ref_no, cust_name, remaining)
                self.reference_selector_combo.addItem(label, ref_id)
        except Exception as e:
            print('Error loading references:', e)
        if cur:
            idx = self.reference_selector_combo.findData(cur)
            if idx >= 0:
                self.reference_selector_combo.setCurrentIndex(idx)
        self.reference_selector_combo.blockSignals(False)
