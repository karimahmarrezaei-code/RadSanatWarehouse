    def _issue_recalc_percent(self):
        try:
            pct_text = self.issue_pct_edit.text().strip()
            if not pct_text:
                self.issue_calc_val.setText('-')
                return

            digits = ''.join(ch for ch in pct_text if ch.isdigit())
            if not digits:
                self.issue_calc_val.setText('-')
                return

            pct = float(digits)

            avg_text = self.avg_price_value.text().replace(' ریال', '').replace(',', '').strip()
            try:
                avg = int(float(avg_text))
            except Exception:
                avg = 0

            if avg <= 0:
                self.issue_calc_val.setText('-')
                return

            calc = int(avg * (1 + pct / 100.0))
            self.issue_calc_val.setText('{:,} ریال (+{}%)'.format(calc, int(pct)))
            if hasattr(self, 'issue_margin_lbl'):
                self.issue_margin_lbl.setText('حاشیه سود روی فروش: {:.1f}%'.format(pct / (100.0 + pct) * 100.0 if pct > 0 else 0))

        except Exception:
            self.issue_calc_val.setText('-')

