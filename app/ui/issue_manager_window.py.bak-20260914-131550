    def rollback_selected_issue(self) -> None:
        if not self.can_manage:
            QMessageBox.warning(self, 'عدم دسترسی', 'شما اجازه rollback حواله را ندارید.')
            return

        row = self.issues_table.currentRow()
        if row < 0:
            QMessageBox.information(self, 'rollback حواله', 'ابتدا یک حواله را از جدول انتخاب کنید.')
            return

        item = self.issues_table.item(row, 0)
        if not item:
            return

        if not item.text().strip().isdigit():
            QMessageBox.information(self, 'توجه', 'یک ردیف حواله (زیرشاخه) را انتخاب کنید.')
            return
        issue_id = int(item.text())
        rollback_items = []

        try:
            with self.db.connect() as conn:
                conn.row_factory = None
                lines = conn.execute(
                    """
                    SELECT wii.row_no, wii.pallet_id, wii.qty, wii.unit_price, wii.total_price, wii.warehouse_id,
                           p.code, p.name, w.name,
                           (COALESCE((SELECT SUM(o.qty) FROM opening_inventory_items o WHERE o.pallet_id = wii.pallet_id), 0)
                            + COALESCE((SELECT SUM(CASE WHEN t.transaction_type='IN' THEN t.qty_in ELSE -t.qty_out END)
                                        FROM inventory_transactions t
                                        WHERE t.pallet_id = wii.pallet_id
                                          AND t.warehouse_id = wii.warehouse_id
                                          AND COALESCE(t.is_void, 0) = 0), 0)) AS current_qty
                    FROM warehouse_issue_items wii
                    JOIN pallets p ON p.id = wii.pallet_id
                    LEFT JOIN warehouses w ON w.id = wii.warehouse_id
                    WHERE wii.issue_id = ?
                    ORDER BY wii.row_no
                    """,
                    (issue_id,)
                ).fetchall()

                for line in lines:
                    current_qty = int(line[9] or 0)
                    rollback_qty = int(line[2])
                    rollback_items.append({
                        'row_no': line[0],
                        'pallet_code': line[6],
                        'pallet_name': line[7],
                        'warehouse_name': line[8] or '-',
                        'rollback_qty': rollback_qty,
                        'current_qty': current_qty,
                        'after_qty': current_qty + rollback_qty,
                    })

        except Exception as exc:
            QMessageBox.critical(self, 'خطا', f'خطا در بررسی موجودی:\n{exc}')
            return

        dialog = QDialog(self)
        dialog.setWindowTitle('پیش‌نمایش ابطال حواله')
        dialog.resize(900, 600)
        dialog.setLayoutDirection(Qt.RightToLeft)

        layout = QVBoxLayout(dialog)

        impact_group = QGroupBox('تأثیر ابطال بر موجودی پالت‌ها')
        impact_layout = QVBoxLayout(impact_group)

        impact_table = QTableWidget(0, 7)
        impact_table.setHorizontalHeaderLabels(
            ['ردیف', 'کد پالت', 'نام پالت', 'انبار', 'موجودی فعلی', 'کاهش', 'موجودی پس از ابطال']
        )
        impact_table.verticalHeader().setVisible(False)
        impact_table.setRowCount(len(rollback_items))

        for idx, it in enumerate(rollback_items):
            vals = [
                str(it['row_no']),
                it['pallet_code'],
                it['pallet_name'],
                it['warehouse_name'],
                f"{it['current_qty']:,}",
                f"+{it['rollback_qty']:,}",
                f"{it['after_qty']:,}"
            ]
            for col, v in enumerate(vals):
                cell = QTableWidgetItem(v)
                cell.setTextAlignment(Qt.AlignCenter | Qt.AlignVCenter)
                impact_table.setItem(idx, col, cell)

        impact_table.resizeColumnsToContents()
        impact_layout.addWidget(impact_table)
        layout.addWidget(impact_group)

        btn_layout = QHBoxLayout()
        cancel_btn = QPushButton('انصراف')
        cancel_btn.clicked.connect(dialog.reject)

        confirm_btn = QPushButton('تأیید و ابطال')
        confirm_btn.setObjectName('DangerButton')
        confirm_btn.clicked.connect(dialog.accept)

        btn_layout.addStretch()
        btn_layout.addWidget(cancel_btn)
        btn_layout.addWidget(confirm_btn)
        layout.addLayout(btn_layout)

        if dialog.exec_() != QDialog.Accepted:
            return

        try:
            result = self.repository.rollback_issue(issue_id, user_id=self.user_data.get('id'))
        except Exception as exc:
            QMessageBox.critical(self, 'خطا', f'rollback حواله با خطا مواجه شد:\n{exc}')
            return

        QMessageBox.information(
            self,
            'rollback حواله',
            result.get('message') or 'حواله با موفقیت ابطال شد.'
        )

        report_dialog = QDialog(self)
        report_dialog.setWindowTitle('گزارش ابطال حواله')
        report_dialog.resize(700, 450)
        report_dialog.setLayoutDirection(Qt.RightToLeft)

        r_layout = QVBoxLayout(report_dialog)

        ok_lbl = QLabel('✔ عملیات ابطال با موفقیت انجام شد')
        ok_lbl.setStyleSheet('color:#10b981;font-size:18px;font-weight:bold;')
        ok_lbl.setAlignment(Qt.AlignCenter)
        r_layout.addWidget(ok_lbl)

        r_layout.addWidget(QLabel(result.get('message') or ''))
        r_layout.addWidget(QLabel(f"تعداد کل ابطال: {sum(it['rollback_qty'] for it in rollback_items):,} پالت"))

        summary = 'پالت‌های تحت تأثیر:\n' + '\n'.join(
            f"  • {it['pallet_code']} ({it['pallet_name']}) در {it['warehouse_name']}: "
            f"{it['current_qty']:,} → {it['after_qty']:,} ({it['rollback_qty']:,}+)"
            for it in rollback_items
        )

        sum_lbl = QLabel(summary)
        sum_lbl.setWordWrap(True)
        r_layout.addWidget(sum_lbl)

        note_lbl = QLabel('⚠ اسناد مالی مرتبط ابطال و سند برگشتی روزنامه ثبت شد.')
        note_lbl.setStyleSheet('color:#f59e0b;')
        r_layout.addWidget(note_lbl)

        close_btn = QPushButton('بستن')
        close_btn.clicked.connect(report_dialog.accept)
        r_layout.addWidget(close_btn)

        report_dialog.exec_()

        self._load_lookups()
        self._load_pallet_prices()
        self.refresh_issues_final()
        self.data_changed.emit()

