    def _update_ref_remaining_label(self):
        try:
            from PyQt5.QtWidgets import QLabel
            combo = getattr(self, 'reference_selector_combo', None)
            if combo is None:
                return
            if not hasattr(self, 'ref_remaining_label'):
                self.ref_remaining_label = QLabel('')
                self.ref_remaining_label.setStyleSheet('color: #f59e0b; font-weight: bold; padding: 2px 6px;')
                try:
                    combo.parentWidget().layout().addWidget(self.ref_remaining_label)
                except Exception:
                    pass
            ref_id = combo.currentData()
            if not ref_id:
                self.ref_remaining_label.setText('')
                return
            with self.db.connect() as conn:
                conn.row_factory = None
                rows = conn.execute(
                    "SELECT oli.pallet_id, p.code, COALESCE(SUM(oli.qty),0) "
                    "FROM outbound_load_items oli JOIN pallets p ON p.id = oli.pallet_id "
                    "WHERE oli.outbound_load_id = ? GROUP BY oli.pallet_id ORDER BY oli.row_no",
                    (ref_id,)).fetchall()
                issued = conn.execute(
                    "SELECT wii.pallet_id, COALESCE(SUM(wii.qty),0) FROM warehouse_issue_items wii "
                    "JOIN warehouse_issues wi ON wi.id = wii.issue_id "
                    "WHERE wi.outbound_load_id = ? AND wi.issue_status != 'CANCELLED' "
                    "GROUP BY wii.pallet_id", (ref_id,)).fetchall()
            iss_map = {r[0]: int(r[1] or 0) for r in issued}
            parts = []
            for pid, code, q in rows:
                rem = int(q or 0) - iss_map.get(pid, 0)
                parts.append('{}: {}'.format(code, rem))
            self.ref_remaining_label.setText('مانده مرجع → ' + ' | '.join(parts) if parts else '')
        except Exception:
            pass
